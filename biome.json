{
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",

          "options": {
            "groups": [
              ":URL:",

              ":NODE:"
            ]
          }
        }
      }
    }
  },
  "files": {
    "includes": ["**", "!node_modules", "!dist", "!build"]
  }
}
